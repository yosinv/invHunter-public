# Anthropic (Claude API)
ANTHROPIC_API_KEY=sk-ant-...

# Telegram bot — the bot only answers chat IDs listed here (comma-separated)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (Gmail App Password, not your login password)
EMAIL_FROM=
EMAIL_TO=
EMAIL_PASSWORD=
